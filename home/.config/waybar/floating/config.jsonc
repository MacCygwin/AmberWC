{
  // Floating "islands" bar: three rounded capsules over a transparent top bar.
  "layer": "top",
  "position": "top",
  "height": 46,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "margin-bottom": 0,
  "spacing": 2,

  "modules-left": ["custom/launcher", "ext/workspaces"],
  "modules-center": ["custom/browse", "custom/term", "custom/files", "wlr/taskbar"],
  "modules-right": ["tray", "power-profiles-daemon", "pulseaudio", "network", "battery", "clock"],

  "custom/launcher": {
    "format": "󱄅",
    "on-click": "pkill -x rofi || rofi -show drun -theme ~/.config/rofi/themes/launcher.rasi",
    "tooltip": false
  },
  "custom/browse": { "format": "󰖟", "on-click": "firefox", "tooltip": false },
  "custom/term":   { "format": "󰆍", "on-click": "foot", "tooltip": false },
  "custom/files":  { "format": "󰉋", "on-click": "pcmanfm", "tooltip": false },

  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-name": false
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "icon-theme": "Papirus-Dark",
    "spacing": 6,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "pulseaudio": {
    "format": "<span foreground='#FFC766'>{icon}</span> {volume}%",
    "format-muted": "<span foreground='#A8895A'>󰝟</span> muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{desc}",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "~/.local/bin/qs-panel"
  },

  "network": {
    "format-wifi": "<span foreground='#F5E1B5'>󰖩</span> {signalStrength}%",
    "format-ethernet": "<span foreground='#F5E1B5'>󰈀</span> Wired",
    "format-disconnected": "<span foreground='#A8895A'>󰖪</span> Offline",
    "tooltip-format-wifi": "{essid}  ·  {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}  ·  {ipaddr}",
    "on-click": "~/.local/bin/qs-panel"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "<span foreground='#F5E1B5'>{icon}</span> {capacity}%",
    "format-charging": "<span foreground='#FFC766'>󰂄</span> {capacity}%",
    "format-warning": "<span foreground='#FF9F3F'>{icon}</span> {capacity}%",
    "format-critical": "<span foreground='#E5533D'>{icon}</span> {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}%  ·  {timeTo}",
    "on-click": "~/.local/bin/qs-panel"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "~/.local/bin/qs-panel",
    "on-click-right": "~/.local/bin/calendar-popup"
  }
}
