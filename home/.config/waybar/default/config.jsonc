{
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "margin-top": 4,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["custom/launcher"],
  "modules-center": ["custom/browse", "custom/term", "custom/files", "wlr/taskbar"],
  "modules-right": ["tray", "pulseaudio", "network", "battery", "clock"],
  
  "custom/launcher": { 
    "format": " ", 
    "on-click": "nwg-drawer", 
    "tooltip": false 
  },
  "custom/browse": {
    "format": "󰖟",
    "on-click": "firefox",
    "tooltip": false
  },
  "custom/term": { 
    "format": "󰆍", 
    "on-click": "foot", 
    "tooltip": false 
  },
  "custom/files": { 
    "format": "󰉋", 
    "on-click": "pcmanfm", 
    "tooltip": false 
  },
  "wlr/taskbar": { 
    "format": "{icon}", 
    "icon-size": 22, 
    "icon-theme": "Papirus-Dark",
    "spacing": 8,
    "on-click": "activate", 
    "on-click-middle": "close",
    "tooltip": false
  },
  "pulseaudio": {
    "on-click-right": "swaync-client -t -sw",
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "on-click": "swaync-client -t -sw",
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },
  "battery": {
    "on-click": "swaync-client -t -sw",
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#FFC766'><b>{}</b></span>",
        "weekdays": "<span color='#A8895A'>{}</span>",
        "days": "<span color='#F5E1B5'>{}</span>",
        "today": "<span color='#FFC766'><b><u>{}</u></b></span>"
      }
    },
    "on-click": "swaync-client -t -sw",
    "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down", "on-click-right": "mode" }
  }
}
