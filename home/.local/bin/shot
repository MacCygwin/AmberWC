#!/usr/bin/env bash
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
f="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case "$1" in
  area)
    geo=$(slurp -d -b 0b0a0880 -c ffc766ff -s 00000000 -w 2) || exit 0
    grim -g "$geo" "$f" ;;
  *)
    grim "$f" ;;
esac
wl-copy < "$f"
notify-send "Screenshot saved" "$f"
